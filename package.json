{
  "name": "groovehq-mcp",
  "version": "0.14.0",
  "description": "Working MCP server for Groove HQ, updated for the current API and tested against a live account: search and read tickets, send email replies, add notes, and manage contacts.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "groovehq-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:live": "npm run build && node scripts/live-test.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "pretest": "npm run build"
  },
  "keywords": [
    "mcp",
    "groove",
    "customer-support",
    "help-desk"
  ],
  "author": "Christian Genco <christian@gen.co>",
  "contributors": [
    "Chris <chris@purplebite.nl>",
    "Claude <noreply@anthropic.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purplebite/groovehq-mcp.git"
  },
  "homepage": "https://github.com/purplebite/groovehq-mcp#readme",
  "bugs": {
    "url": "https://github.com/purplebite/groovehq-mcp/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "fflate": "0.8.3",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "unpdf": "1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "transform": {},
    "coverageProvider": "v8",
    "collectCoverageFrom": [
      "dist/**/*.js",
      "!dist/types/**"
    ],
    "coverageReporters": [
      "text-summary",
      "text"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85,
        "branches": 70
      }
    }
  }
}
