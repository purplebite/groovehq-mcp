        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "SENDS AN EMAIL IMMEDIATELY: forwards a ticket to the given addresses. The ticket keeps its state, and only gets a new subject if you pass one. Use only when the user explicitly asks.",
      "inputSchema": {
        "properties": {
          "bcc": {
            "description": "Email addresses to send a hidden copy to",
