          "body",
        ],
        "type": "object",
      },
      "name": "createReplyDraft",
    },
    "deleteContact": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "Permanently delete one contact by exact email address, which also removes it from recipient suggestions. A contact with tickets cannot be deleted: use mergeContacts. Without confirm it only shows what would be deleted. Always show that to the user first. Mail this contact wrote in a merged ticket loses its sender",
      "inputSchema": {
        "properties": {
          "confirm": {
            "default": false,
            "description": "Really delete it. Only after the user agreed",
            "type": "boolean",
          },
          "email": {
            "description": "Exact email address of the contact",
            "type": "string",
          },
        },
        "required": [
          "email",
        ],
        "type": "object",
      },
      "name": "deleteContact",
    },
    "deleteContacts": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "Permanently delete up to 100 contacts by ID, one by one. A contact with tickets is skipped. Without confirm it only shows what would be deleted. Always show that to the user first. Mail these contacts wrote in merged tickets loses its sender",
      "inputSchema": {
        "properties": {
          "confirm": {
            "default": false,
            "description": "Really delete them. Only after the user agreed",
            "type": "boolean",
          },
          "contactIds": {
            "description": "Contact IDs to delete, at most 100",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
        },
        "required": [
          "contactIds",
        ],
        "type": "object",
      },
      "name": "deleteContacts",
    },
    "deleteConversation": {
      "annotations": {
