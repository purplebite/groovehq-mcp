          },
          "attachments": {
            "description": "Files to attach, at most 25, up to 20 MB each. Each has a fileName and either a url (https) or contentBase64. Use url for anything but small files",
            "items": {
              "properties": {
                "contentBase64": {
                  "description": "File content as base64",
                  "type": "string",
                },
                "contentType": {
                  "description": "MIME type, for example application/pdf",
                  "type": "string",
                },
                "fileName": {
                  "description": "File name, with its extension",
                  "type": "string",
                },
                "url": {
                  "description": "Public https link to the file",
                  "type": "string",
                },
              },
              "required": [
                "fileName",
