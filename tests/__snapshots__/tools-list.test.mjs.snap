      "inputSchema": {
        "properties": {
          "downloadUrl": {
            "description": "The downloadUrl of the attachment from listMessages (https://files.groovehq.com/f/download/...)",
            "type": "string",
          },
        },
        "required": [
          "downloadUrl",
        ],
        "type": "object",
      },
      "name": "getAttachment",
    },
    "getChannel": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "Get detailed information about a specific channel",
      "inputSchema": {
        "properties": {
          "id": {
            "description": "The channel ID",
            "type": "string",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "name": "getChannel",
    },
    "getContact": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "Get detailed information about a specific contact",
      "inputSchema": {
        "properties": {
          "id": {
            "description": "The contact ID",
            "type": "string",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "name": "getContact",
    },
    "getContactProfile": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "Get the extra details your own integration shows next to a contact in Groove (Groove's custom profile), as plain text",
      "inputSchema": {
        "properties": {
          "channelId": {
            "description": "The mailbox the profile is shown in, if it differs per mailbox",
            "type": "string",
          },
          "contactId": {
            "description": "The contact ID (co_...)",
            "type": "string",
          },
          "refresh": {
            "description": "Ask the integration for fresh details instead of what Groove has stored",
            "type": "boolean",
          },
        },
        "required": [
          "contactId",
        ],
        "type": "object",
      },
      "name": "getContactProfile",
    },
    "getConversation": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "Get detailed information about a specific conversation",
      "inputSchema": {
        "properties": {
          "id": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "name": "getConversation",
    },
    "getRawEmail": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "Get the original email behind a message, with all its headers (Received, From, Return-Path, authentication results), to check where a mail really came from, for example with phishing or delivery problems",
      "inputSchema": {
        "properties": {
          "messageId": {
            "description": "The message ID from listMessages (msg_...)",
            "type": "string",
          },
        },
        "required": [
          "messageId",
        ],
        "type": "object",
      },
      "name": "getRawEmail",
    },
    "linkResource": {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false,
      },
      "description": "Link a ticket to an item in another system, such as a Jira issue, so it shows in Groove's sidebar. With remove, the link goes again. It only records the link in Groove",
      "inputSchema": {
        "properties": {
          "conversationId": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
          "externalId": {
            "description": "The item's ID in that system, for example the Jira issue key IT-123",
            "type": "string",
          },
          "provider": {
            "description": "The system the item lives in, for example JIRA_CLOUD",
            "enum": [
              "JIRA_CLOUD",
              "JIRA_SERVER",
              "GITHUB",
              "GITHUB_LEGACY",
              "LINEAR",
              "TRELLO",
              "HUBSPOT",
              "SALESFORCE",
              "SHOPIFY",
              "SHOPIFY_V2",
              "STRIPE",
              "RECHARGE",
              "MICROSOFT_OFFICE_365",
              "GOOGLE",
              "OPTIMIZECX",
              "CHAT",
            ],
            "type": "string",
          },
          "remove": {
            "description": "Remove this link instead of adding it",
            "type": "boolean",
          },
          "title": {
            "description": "Title to show in Groove, for example the issue summary",
            "type": "string",
          },
          "url": {
            "description": "Link to the item",
            "type": "string",
          },
        },
        "required": [
          "conversationId",
          "provider",
          "externalId",
          "title",
          "url",
        ],
        "type": "object",
      },
      "name": "linkResource",
    },
    "listAgents": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "List all agents in the organization, with the teams each one is in and the username used to tag them in a note",
      "inputSchema": {
        "properties": {},
        "type": "object",
      },
      "name": "listAgents",
    },
    "listCannedReplies": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "List the team's saved replies (canned replies), so a reply or draft can reuse their wording. Search with keywords or filter by category; each reply shows its category and the mailboxes it is meant for",
      "inputSchema": {
        "properties": {
          "after": {
            "description": "Cursor for the next page (pageInfo.endCursor from the previous result)",
            "type": "string",
          },
          "categoryIds": {
            "description": "Only saved replies in these categories (category IDs from earlier results)",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "keywords": {
            "description": "Words to search for in the name and text of the saved replies",
            "type": "string",
          },
          "limit": {
            "default": 20,
            "description": "Maximum number of saved replies to return per page",
            "type": "number",
          },
        },
        "type": "object",
      },
      "name": "listCannedReplies",
    },
    "listChannels": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "List all available channels/inboxes",
      "inputSchema": {
        "properties": {
          "limit": {
            "default": 50,
            "description": "Maximum number of channels to return",
            "type": "number",
          },
        },
        "type": "object",
      },
      "name": "listChannels",
    },
    "listCompanies": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "List companies with optional search. Returns one page; if pageInfo.hasNextPage is true, more results exist.",
      "inputSchema": {
        "properties": {
          "after": {
            "description": "Cursor for pagination",
            "type": "string",
          },
          "limit": {
            "default": 20,
            "description": "Maximum number of companies to return per page",
            "type": "number",
          },
          "orderBy": {
            "description": "Sort order. Use CONVERSATION_COUNT with DESC for the companies with the most tickets. Groove sorts counts only roughly, so sort the result again before showing a ranking",
            "properties": {
              "direction": {
                "default": "ASC",
                "enum": [
                  "ASC",
                  "DESC",
                ],
                "type": "string",
              },
              "field": {
                "enum": [
                  "CONTACT_COUNT",
                  "CONVERSATION_COUNT",
                  "CREATED_AT",
                  "DOMAIN",
                  "NAME",
                  "UPDATED_AT",
                ],
                "type": "string",
              },
            },
            "required": [
              "field",
            ],
            "type": "object",
          },
          "search": {
            "description": "Search string to filter companies",
            "type": "string",
          },
        },
        "type": "object",
      },
      "name": "listCompanies",
    },
    "listContacts": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "List contacts with optional search, with their ticket counts. Returns one page; if pageInfo.hasNextPage is true, more results exist.",
      "inputSchema": {
        "properties": {
          "after": {
            "description": "Cursor for pagination",
            "type": "string",
          },
          "email": {
            "description": "Find the contact with exactly this email address",
            "type": "string",
          },
          "limit": {
            "default": 20,
            "description": "Maximum number of contacts per page. Groove returns at most 100. With orphansOnly it stops reading at this many, default 50, and can return slightly more",
            "type": "number",
          },
          "olderThanDays": {
            "description": "With orphansOnly: skip contacts created in the last N days",
            "type": "number",
          },
          "orderBy": {
            "description": "Sort order",
            "properties": {
              "direction": {
                "default": "ASC",
                "enum": [
                  "ASC",
                  "DESC",
                ],
                "type": "string",
              },
              "field": {
                "enum": [
                  "COMPANY_NAME",
                  "CONVERSATION_COUNT",
                  "CREATED_AT",
                  "EMAIL",
                  "JOB_TITLE",
                  "LAST_SEEN_AT",
                  "NAME",
                  "UPDATED_AT",
                ],
                "type": "string",
              },
            },
            "required": [
              "field",
            ],
            "type": "object",
          },
          "orphansOnly": {
            "description": "Only contacts with 0 tickets. Reads at most 500 contacts per call, so call again with after for more. Never deletes anything. A contact can have 0 tickets and still have been CCed or have written mail in a merged ticket",
            "type": "boolean",
          },
          "search": {
            "description": "Search string to filter contacts. Also finds part of a name or address",
            "type": "string",
          },
        },
        "type": "object",
      },
      "name": "listContacts",
    },
    "listConversationAuthors": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "Who replied or left a note in which tickets. Groove cannot filter on this, so the tool reads the messages of every matching ticket itself, 40 tickets per request, and returns totals per agent: tickets, replies, notes, first and last message. With agentId it also lists that agent's tickets. Use this instead of calling listMessages per ticket. It takes the filters of listConversations, plus writtenAfter and writtenBefore for the messages themselves. Up to 1000 matching tickets are read without asking; above that it stops and needs confirm: true",
      "inputSchema": {
        "properties": {
          "agentId": {
            "description": "Only count this agent, and list the tickets they wrote in",
            "type": "string",
          },
          "assignedAgentId": {
            "description": "Filter by assigned agent ID",
            "type": "string",
          },
          "assignedTeamId": {
            "description": "Filter by assigned team ID",
            "type": "string",
          },
          "channelId": {
            "description": "Filter by channel ID",
            "type": "string",
          },
          "confirm": {
            "default": false,
            "description": "Read more than 1000 tickets. Only after the user agreed to the number of requests",
            "type": "boolean",
          },
          "contactEmail": {
            "description": "Only tickets from the contact with this email address",
            "type": "string",
          },
          "contactId": {
            "description": "Filter by contact ID",
            "type": "string",
          },
          "createdAfter": {
            "description": "Only tickets created on or after this moment, as an ISO date or date-time (2026-10-01 means midnight UTC)",
            "type": "string",
          },
          "createdBefore": {
            "description": "Only tickets created on or before this moment, as an ISO date or date-time. For all of October, use 2026-10-31T23:59:59Z",
            "type": "string",
          },
          "deleted": {
            "description": "true for tickets in the trash only, false for tickets outside it",
            "type": "boolean",
          },
          "draftAuthorId": {
            "description": "Only tickets where this agent has an unsent draft",
            "type": "string",
          },
          "draftType": {
            "description": "Only tickets with an unsent draft of this kind",
            "enum": [
              "reply",
              "reply_all",
              "note",
            ],
            "type": "string",
          },
          "folderId": {
            "description": "Only tickets in this Smart Folder. Get the ID from listFolders. Don't combine it with channelId, unless that mailbox is listed for the folder.",
            "type": "string",
          },
          "keywords": {
            "description": "Full-text search across conversations",
            "type": "string",
          },
          "mentionedAgentId": {
            "description": "Only tickets where this agent was @mentioned in a note",
            "type": "string",
          },
          "rating": {
            "description": "Only tickets whose latest customer rating is this; any means rated at all",
            "enum": [
              "any",
              "awesome",
              "ok",
              "bad",
            ],
            "type": "string",
          },
          "starred": {
            "description": "true for starred tickets only, false for tickets without a star",
            "type": "boolean",
          },
          "state": {
            "description": "Filter by conversation state. opened also includes unread, but leaves out snoozed: ask for snoozed separately to see every ticket that still needs work. For tickets in the trash, use deleted",
            "enum": [
              "unread",
              "opened",
              "closed",
              "snoozed",
              "spam",
            ],
            "type": "string",
          },
          "states": {
            "description": "Tickets in any of these states, for example ["opened", "snoozed"]. Ignored when state is set",
            "items": {
              "enum": [
                "unread",
                "opened",
                "closed",
                "snoozed",
                "spam",
              ],
              "type": "string",
            },
            "type": "array",
          },
          "tagIds": {
            "description": "Filter by tag IDs",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "tagNames": {
            "description": "Tickets with any of these tag names, without looking up their IDs first",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "type": {
            "description": "Only tickets that came in this way",
            "items": {
              "enum": [
                "email",
                "chat",
                "widget",
                "facebook",
                "twitter",
              ],
              "type": "string",
            },
            "type": "array",
          },
          "updatedAfter": {
            "description": "Only tickets updated on or after this moment, as an ISO date or date-time",
            "type": "string",
          },
          "updatedBefore": {
            "description": "Only tickets updated on or before this moment, as an ISO date or date-time",
            "type": "string",
          },
          "writtenAfter": {
            "description": "Only messages written on or after this date (a date alone means midnight UTC). Combine with updatedAfter so the ticket list stays small",
            "type": "string",
          },
          "writtenBefore": {
            "description": "Only messages written before this date. A date alone means midnight UTC at its start, so for a whole month give the first day of the next one",
            "type": "string",
          },
        },
        "type": "object",
      },
      "name": "listConversationAuthors",
    },
    "listConversations": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "List conversations with optional filters. Returns one page; if pageInfo.hasNextPage is true, more results exist. totalCount is the number of matching tickets across all pages, so for a count, ask for limit 1. If totalCountCapped is true, Groove stopped counting and the real number is higher",
      "inputSchema": {
        "properties": {
          "after": {
            "description": "Cursor for the next page (pageInfo.endCursor from the previous result)",
            "type": "string",
          },
          "assignedAgentId": {
            "description": "Filter by assigned agent ID",
            "type": "string",
          },
          "assignedTeamId": {
            "description": "Filter by assigned team ID",
            "type": "string",
          },
          "channelId": {
            "description": "Filter by channel ID",
            "type": "string",
          },
          "contactEmail": {
            "description": "Only tickets from the contact with this email address",
            "type": "string",
          },
          "contactId": {
            "description": "Filter by contact ID",
            "type": "string",
          },
          "createdAfter": {
            "description": "Only tickets created on or after this moment, as an ISO date or date-time (2026-10-01 means midnight UTC)",
            "type": "string",
          },
          "createdBefore": {
            "description": "Only tickets created on or before this moment, as an ISO date or date-time. For all of October, use 2026-10-31T23:59:59Z",
            "type": "string",
          },
          "deleted": {
            "description": "true for tickets in the trash only, false for tickets outside it",
            "type": "boolean",
          },
          "draftAuthorId": {
            "description": "Only tickets where this agent has an unsent draft",
            "type": "string",
          },
          "draftType": {
            "description": "Only tickets with an unsent draft of this kind",
            "enum": [
              "reply",
              "reply_all",
              "note",
            ],
            "type": "string",
          },
          "folderId": {
            "description": "Only tickets in this Smart Folder. Get the ID from listFolders. Don't combine it with channelId, unless that mailbox is listed for the folder.",
            "type": "string",
          },
          "keywords": {
            "description": "Full-text search across conversations",
            "type": "string",
          },
          "limit": {
            "default": 20,
            "description": "Maximum number of conversations to return per page",
            "type": "number",
          },
          "mentionedAgentId": {
            "description": "Only tickets where this agent was @mentioned in a note",
            "type": "string",
          },
          "orderBy": {
            "description": "Sort order. STATE_CHANGED_AT with state closed lists recently closed tickets first; each ticket's stateUpdatedAt is its latest state change",
            "properties": {
              "direction": {
                "default": "DESC",
                "enum": [
                  "ASC",
                  "DESC",
                ],
                "type": "string",
              },
              "field": {
                "enum": [
                  "CREATED_AT",
                  "UPDATED_AT",
                  "STATE_CHANGED_AT",
                  "LAST_UNANSWERED_USER_MESSAGE_AT",
                ],
                "type": "string",
              },
            },
            "required": [
              "field",
            ],
            "type": "object",
          },
          "rating": {
            "description": "Only tickets whose latest customer rating is this; any means rated at all",
            "enum": [
              "any",
              "awesome",
              "ok",
              "bad",
            ],
            "type": "string",
          },
          "starred": {
            "description": "true for starred tickets only, false for tickets without a star",
            "type": "boolean",
          },
          "state": {
            "description": "Filter by conversation state. opened also includes unread, but leaves out snoozed: ask for snoozed separately to see every ticket that still needs work. For tickets in the trash, use deleted",
            "enum": [
              "unread",
              "opened",
              "closed",
              "snoozed",
              "spam",
            ],
            "type": "string",
          },
          "states": {
            "description": "Tickets in any of these states, for example ["opened", "snoozed"]. Ignored when state is set",
            "items": {
              "enum": [
                "unread",
                "opened",
                "closed",
                "snoozed",
                "spam",
              ],
              "type": "string",
            },
            "type": "array",
          },
          "tagIds": {
            "description": "Filter by tag IDs",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "tagNames": {
            "description": "Tickets with any of these tag names, without looking up their IDs first",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "type": {
            "description": "Only tickets that came in this way",
            "items": {
              "enum": [
                "email",
                "chat",
                "widget",
                "facebook",
                "twitter",
              ],
              "type": "string",
            },
            "type": "array",
          },
          "updatedAfter": {
            "description": "Only tickets updated on or after this moment, as an ISO date or date-time",
            "type": "string",
          },
          "updatedBefore": {
            "description": "Only tickets updated on or before this moment, as an ISO date or date-time",
            "type": "string",
          },
        },
        "type": "object",
      },
      "name": "listConversations",
    },
    "listDrafts": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "List your own unsent drafts, optionally for one ticket. Read-only. Drafts of other agents are not visible through the API.",
      "inputSchema": {
        "properties": {
          "conversationId": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
        },
        "type": "object",
      },
      "name": "listDrafts",
    },
    "listFolders": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "List the Smart Folders this agent can open, in sidebar order, with their teams, agents, mailboxes, and the team they filter on. Names can repeat, so check these before you pick one.",
      "inputSchema": {
        "properties": {},
        "type": "object",
      },
      "name": "listFolders",
    },
    "listLinkedResources": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "List what a ticket is linked to in other systems through Groove, such as Jira issues, with title and link",
      "inputSchema": {
        "properties": {
          "conversationId": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
        },
        "required": [
          "conversationId",
        ],
        "type": "object",
      },
      "name": "listLinkedResources",
    },
    "listMessages": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "List messages and notes in a conversation, oldest first. Groove can still return notes that were deleted, and mail that was moved to another ticket. To see who wrote in many tickets, use listConversationAuthors instead of calling this per ticket",
      "inputSchema": {
        "properties": {
          "conversationId": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
          "format": {
            "description": "plain leaves out the HTML body and keeps bodyPlainText, which makes the result about half the size (default: full)",
            "enum": [
              "full",
              "plain",
            ],
            "type": "string",
          },
          "from": {
            "description": "Which end limit counts from: end (default) gives the latest messages, start gives the first ones, such as the original question",
            "enum": [
              "start",
              "end",
            ],
            "type": "string",
          },
          "limit": {
            "description": "Return only this many messages (default: all), counted from the end unless from is start. The whole ticket is still read, to sort merged messages by date",
            "type": "number",
          },
        },
        "required": [
          "conversationId",
        ],
        "type": "object",
      },
      "name": "listMessages",
    },
    "listRules": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "List Groove's automatic rules in the order they run: when each one fires, its conditions and actions, and how often it ran. Useful to explain why a ticket got a tag, an assignee or a status. Read only",
      "inputSchema": {
        "properties": {
          "state": {
            "description": "Only active or only inactive rules (default: both)",
            "enum": [
              "active",
              "inactive",
            ],
            "type": "string",
          },
        },
        "type": "object",
      },
      "name": "listRules",
    },
    "listTags": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "List all tags, for filtering or tagging tickets",
      "inputSchema": {
        "properties": {
          "search": {
            "description": "Search string to filter tags by name",
            "type": "string",
          },
        },
        "type": "object",
      },
      "name": "listTags",
    },
    "listTeams": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "List all teams, for filtering or assigning tickets. With includeMembers, each team also lists its agents",
      "inputSchema": {
        "properties": {
          "includeMembers": {
            "description": "Also list the agents in each team (id, name, email)",
            "type": "boolean",
          },
        },
        "type": "object",
      },
      "name": "listTeams",
    },
    "logConversation": {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false,
      },
      "description": "Groove's Log a Conversation: creates a ticket for a contact that starts with an internal note, for example to record a phone call. Never sends email.",
      "inputSchema": {
        "properties": {
          "assignedAgentId": {
            "description": "ID of agent to assign the ticket to",
            "type": "string",
          },
          "assignedTeamId": {
            "description": "ID of team to assign the ticket to",
            "type": "string",
          },
          "body": {
            "description": "Text of the internal note",
            "type": "string",
          },
          "channelId": {
            "description": "ID of the email channel for the ticket",
            "type": "string",
          },
          "phone": {
            "description": "Phone number of the contact, for example when logging a call",
            "type": "string",
          },
          "skipNotifications": {
            "description": "Do not notify agents about the new ticket",
            "type": "boolean",
          },
          "state": {
            "default": "opened",
            "description": "State of the new ticket",
            "enum": [
              "opened",
              "closed",
            ],
            "type": "string",
          },
          "subject": {
            "description": "Subject of the ticket",
            "type": "string",
          },
          "to": {
            "description": "Email address of the contact. A new contact is created if needed",
            "type": "string",
          },
          "toName": {
            "description": "Name of the contact (defaults to the email address)",
            "type": "string",
          },
        },
        "required": [
          "channelId",
          "to",
          "subject",
          "body",
        ],
        "type": "object",
      },
      "name": "logConversation",
    },
    "logConversation (2)": {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false,
      },
      "description": "Groove's Log a Conversation: creates a ticket for a contact that starts with an internal note, for example to record a phone call. Never sends email.",
      "inputSchema": {
        "properties": {
          "assignedAgentId": {
            "description": "ID of agent to assign the ticket to",
            "type": "string",
          },
          "assignedTeamId": {
            "description": "ID of team to assign the ticket to",
            "type": "string",
          },
          "authorId": {
            "description": "ID of the agent to act as. Defaults to the agent who owns the API token",
            "type": "string",
          },
          "body": {
            "description": "Text of the internal note",
            "type": "string",
          },
          "channelId": {
            "description": "ID of the email channel for the ticket",
            "type": "string",
          },
          "phone": {
            "description": "Phone number of the contact, for example when logging a call",
            "type": "string",
          },
          "skipNotifications": {
            "description": "Do not notify agents about the new ticket",
            "type": "boolean",
          },
          "state": {
            "default": "opened",
            "description": "State of the new ticket",
            "enum": [
              "opened",
              "closed",
            ],
            "type": "string",
          },
          "subject": {
            "description": "Subject of the ticket",
            "type": "string",
          },
          "to": {
            "description": "Email address of the contact. A new contact is created if needed",
            "type": "string",
          },
          "toName": {
            "description": "Name of the contact (defaults to the email address)",
            "type": "string",
          },
        },
        "required": [
          "channelId",
          "to",
          "subject",
          "body",
        ],
        "type": "object",
      },
      "name": "logConversation",
    },
    "logConversation (3)": {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false,
      },
      "description": "Groove's Log a Conversation: creates a ticket for a contact that starts with an internal note, for example to record a phone call. Never sends email.",
      "inputSchema": {
        "properties": {
          "assignedAgentId": {
            "description": "ID of agent to assign the ticket to",
            "type": "string",
          },
          "assignedTeamId": {
            "description": "ID of team to assign the ticket to",
            "type": "string",
          },
          "attachments": {
            "description": "Files to attach, at most 25, up to 20 MB each. Each has a fileName and either a url (https) or contentBase64. Use url for anything but small files",
            "items": {
              "properties": {
                "contentBase64": {
                  "description": "File content as base64",
                  "type": "string",
                },
                "contentType": {
                  "description": "MIME type, for example application/pdf",
                  "type": "string",
                },
                "fileName": {
                  "description": "File name, with its extension",
                  "type": "string",
                },
                "url": {
                  "description": "Public https link to the file",
                  "type": "string",
                },
              },
              "required": [
                "fileName",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "body": {
            "description": "Text of the internal note",
            "type": "string",
          },
          "channelId": {
            "description": "ID of the email channel for the ticket",
            "type": "string",
          },
          "phone": {
            "description": "Phone number of the contact, for example when logging a call",
            "type": "string",
          },
          "skipNotifications": {
            "description": "Do not notify agents about the new ticket",
            "type": "boolean",
          },
          "state": {
            "default": "opened",
            "description": "State of the new ticket",
            "enum": [
              "opened",
              "closed",
            ],
            "type": "string",
          },
          "subject": {
            "description": "Subject of the ticket",
            "type": "string",
          },
          "to": {
            "description": "Email address of the contact. A new contact is created if needed",
            "type": "string",
          },
          "toName": {
            "description": "Name of the contact (defaults to the email address)",
            "type": "string",
          },
        },
        "required": [
          "channelId",
          "to",
          "subject",
          "body",
        ],
        "type": "object",
      },
      "name": "logConversation",
    },
    "logConversation (4)": {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false,
      },
      "description": "Groove's Log a Conversation: creates a ticket for a contact that starts with an internal note, for example to record a phone call. Never sends email.",
      "inputSchema": {
        "properties": {
          "assignedAgentId": {
            "description": "ID of agent to assign the ticket to",
            "type": "string",
          },
          "assignedTeamId": {
