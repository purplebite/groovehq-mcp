    "markAsSpam": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "Mark a ticket as spam. Groove also blacklists the sender, so their future mail to any mailbox is marked as spam too. Always confirm with the user first. restoreConversation brings the ticket back, but the blacklist can only be undone in the Groove settings.",
      "inputSchema": {
        "properties": {
          "id": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "name": "markAsSpam",
    },
    "mergeContacts": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "Permanently merge one contact into another, for example a typo address into the right one. This cannot be undone, so always confirm with the user first. The source contact and its address disappear. Its tickets move to the target, and its mail then shows the target as sender",
      "inputSchema": {
        "properties": {
          "source": {
            "description": "Contact that disappears: exact email address or contact ID",
            "type": "string",
          },
          "target": {
            "description": "Contact that stays: exact email address or contact ID",
            "type": "string",
          },
        },
        "required": [
          "source",
          "target",
        ],
        "type": "object",
      },
      "name": "mergeContacts",
    },
    "mergeConversations": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "Permanently merge one ticket into another. This cannot be undone, so always confirm with the user first. The source ticket disappears. The target keeps its contact, subject and assignee. Replies and notes move over and tags are combined. Drafts on the source are deleted, and an open source reopens the target",
      "inputSchema": {
        "properties": {
          "allowDifferentContacts": {
            "description": "Merge even though the tickets have different contacts. Only after the user agreed",
            "type": "boolean",
          },
          "discardDrafts": {
            "description": "Merge even though the source has drafts, which get deleted. Only after the user agreed",
            "type": "boolean",
          },
          "sourceId": {
            "description": "Ticket that disappears: number (e.g. 12345) or conversation ID",
            "type": "string",
          },
          "targetId": {
            "description": "Ticket that stays: number (e.g. 12345) or conversation ID",
            "type": "string",
          },
        },
        "required": [
          "sourceId",
          "targetId",
        ],
        "type": "object",
      },
      "name": "mergeConversations",
    },
    "reactToNote": {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false,
      },
      "description": "Add a reaction to an internal note, or remove it if this agent already gave that reaction. Groove does not show reactions through the API.",
      "inputSchema": {
        "properties": {
          "messageId": {
            "description": "ID of the note",
            "type": "string",
          },
          "reaction": {
            "description": "The emoji, for example 👍",
            "type": "string",
          },
        },
        "required": [
          "messageId",
          "reaction",
        ],
        "type": "object",
      },
      "name": "reactToNote",
    },
    "restoreConversation": {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false,
      },
      "description": "Restore a ticket from spam or deleted. It gets back the state it had before, opened if that is unknown",
      "inputSchema": {
        "properties": {
          "id": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "name": "restoreConversation",
    },
    "searchKbArticles": {
      "annotations": {
        "readOnlyHint": true,
      },
      "description": "Search knowledge base articles. Returns one page; if pageInfo.hasNextPage is true, more results exist.",
      "inputSchema": {
        "properties": {
          "after": {
            "description": "Cursor for pagination",
            "type": "string",
          },
          "limit": {
            "default": 20,
            "description": "Maximum number of articles to return per page",
            "type": "number",
          },
          "query": {
            "description": "Search query",
            "type": "string",
          },
        },
        "required": [
          "query",
        ],
        "type": "object",
      },
      "name": "searchKbArticles",
    },
    "sendMessage": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "SENDS AN EMAIL IMMEDIATELY as a reply on a ticket. Use only when the user explicitly asks to send this message; to prepare a reply for review, use createReplyDraft.",
      "inputSchema": {
        "properties": {
          "bcc": {
            "description": "Email addresses to send a hidden copy to",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "body": {
            "description": "The message body content",
            "type": "string",
          },
          "cc": {
            "description": "Email addresses to send a copy to",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "conversationId": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
          "to": {
            "description": "Email address of the recipient",
            "type": "string",
          },
        },
        "required": [
          "conversationId",
          "to",
          "body",
        ],
        "type": "object",
      },
      "name": "sendMessage",
    },
