    "createNote": {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false,
      },
      "description": "Create an internal note in a conversation. Returns the ticket and the note as Groove stored it. To tag colleagues so they get a notification, pass mentionAgentIds",
      "inputSchema": {
        "properties": {
          "body": {
            "description": "The note as HTML. Line breaks need <p> or <br>, because plain newlines are dropped. A tag written by hand is <span class="mention">@username</span>, with the username from listAgents; plain @name text is not a tag",
            "type": "string",
          },
          "conversationId": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
          "mentionAgentIds": {
            "description": "Agent IDs to tag at the start of the note. Each one is checked first; an unknown or inactive agent stops the note",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
        },
        "required": [
          "conversationId",
          "body",
        ],
        "type": "object",
      },
      "name": "createNote",
    },
