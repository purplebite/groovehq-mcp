          "changesetId",
        ],
        "type": "object",
      },
      "name": "undoSend",
    },
    "updateCompany": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "Change a company's name or its extra domains. Groove often creates companies from mail domains, with no name or just the domain",
      "inputSchema": {
        "properties": {
          "addDomains": {
            "description": "Extra domains to add (existing domains are kept)",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "id": {
            "description": "The company ID",
            "type": "string",
          },
          "name": {
            "description": "New name of the company",
            "type": "string",
          },
          "removeDomains": {
            "description": "Extra domains to remove. The main domain cannot be removed",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "name": "updateCompany",
    },
    "updateContact": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "Update contact information, companies and extra email addresses",
      "inputSchema": {
        "properties": {
          "addSecondaryEmails": {
            "description": "Extra email addresses to add to the contact (existing ones are kept)",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "companyIds": {
            "description": "Company IDs to add the contact to (existing companies are kept)",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "email": {
            "description": "Contact email address",
            "type": "string",
          },
          "firstName": {
            "description": "Contact first name",
            "type": "string",
          },
          "id": {
            "description": "The contact ID",
            "type": "string",
          },
          "lastName": {
            "description": "Contact last name",
            "type": "string",
          },
          "phone": {
            "description": "Contact phone number",
            "type": "string",
          },
          "removeCompanyIds": {
            "description": "Company IDs to remove the contact from",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "removeSecondaryEmails": {
            "description": "Extra email addresses to remove. Use email to change the main address",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "title": {
            "description": "Contact job title",
            "type": "string",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "name": "updateContact",
    },
    "updateConversation": {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false,
      },
      "description": "Update a conversation (status, assignee, tags). Can also unassign and remove tags. To delete a ticket, use deleteConversation. To mark it as spam, use markAsSpam",
      "inputSchema": {
        "properties": {
          "allowNoAccess": {
            "description": "Move even though this account has no access to the mailbox, so it can't read the ticket or move it back afterwards. Only after the user agreed",
            "type": "boolean",
          },
          "assignedAgentId": {
            "description": "ID of agent to assign the conversation to",
            "type": "string",
          },
          "assignedTeamId": {
            "description": "ID of team to assign the conversation to",
            "type": "string",
          },
          "channelId": {
            "description": "Move the ticket to this mailbox. Refused if this account has no access to it, unless allowNoAccess is set",
            "type": "string",
          },
          "contactId": {
            "description": "Move the ticket to this contact. The sender of existing mail stays the same",
            "type": "string",
          },
          "followerIds": {
            "description": "Agent IDs to add as followers",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "id": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
          "removeFollowerIds": {
            "description": "Agent IDs to remove as followers",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "removeTagIds": {
            "description": "Tag IDs to remove from the conversation (other tags are kept)",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "snoozedUntil": {
            "description": "ISO 8601 datetime to snooze until",
            "type": "string",
          },
          "starred": {
            "description": "Star or unstar the ticket",
            "type": "boolean",
          },
          "state": {
            "description": "New conversation state",
            "enum": [
              "opened",
              "closed",
              "snoozed",
              "unread",
            ],
            "type": "string",
          },
          "subject": {
            "description": "New subject",
            "type": "string",
          },
          "tagIds": {
            "description": "Tag IDs to add to the conversation (existing tags are kept)",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "unassign": {
            "description": "Unassign the ticket: removes both the agent and the team. Use this unless asked to keep one of them. Add assignedAgentId or assignedTeamId to hand the ticket to someone else",
            "type": "boolean",
          },
          "unassignAgent": {
            "description": "Remove only the agent. The team stays",
            "type": "boolean",
          },
          "unassignTeam": {
            "description": "Remove only the team. The agent stays",
            "type": "boolean",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "name": "updateConversation",
    },
  },
}
`;
