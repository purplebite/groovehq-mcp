            "type": "string",
          },
          "removeDomains": {
            "description": "Extra domains to remove. The main domain cannot be removed",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "name": "updateCompany",
    },
    "updateContact": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "Update contact information, companies and extra email addresses",
      "inputSchema": {
        "properties": {
