            "type": "string",
          },
          "removeCompanyIds": {
            "description": "Company IDs to remove the contact from",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "removeSecondaryEmails": {
            "description": "Extra email addresses to remove. Use email to change the main address",
            "items": {
