            "type": "array",
          },
        },
        "required": [
          "conversationId",
          "body",
        ],
        "type": "object",
      },
      "name": "createNote",
    },
    "createReplyDraft": {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false,
      },
      "description": "Save a reply or note on a ticket as a draft for a person to review. NEVER SENDS anything. Drafts always belong to an existing ticket and are visible only to the agent who owns the API token.",
      "inputSchema": {
        "properties": {
          "bcc": {
            "description": "Bcc email addresses",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "body": {
            "description": "The draft text, as plain text or HTML",
            "type": "string",
          },
          "cc": {
            "description": "Cc email addresses",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "conversationId": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
          "note": {
            "description": "Save an internal note draft instead of a reply; no recipients allowed",
            "type": "boolean",
          },
          "replyAll": {
            "description": "Mark the draft as reply-all in the app",
            "type": "boolean",
          },
          "to": {
            "description": "Recipient email addresses (default: the ticket's contact)",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
        },
        "required": [
          "conversationId",
          "body",
        ],
        "type": "object",
      },
      "name": "createReplyDraft",
    },
    "deleteContact": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "Permanently delete one contact by exact email address, which also removes it from recipient suggestions. A contact with tickets cannot be deleted: use mergeContacts. Without confirm it only shows what would be deleted. Always show that to the user first. Mail this contact wrote in a merged ticket loses its sender",
      "inputSchema": {
        "properties": {
          "confirm": {
            "default": false,
            "description": "Really delete it. Only after the user agreed",
            "type": "boolean",
          },
          "email": {
            "description": "Exact email address of the contact",
            "type": "string",
          },
        },
        "required": [
          "email",
        ],
        "type": "object",
      },
      "name": "deleteContact",
    },
    "deleteConversation": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "Delete a ticket. It goes to the trash, and restoreConversation brings it back with its messages and notes. Without confirm it only shows which ticket would go: show that to the user first.",
      "inputSchema": {
        "properties": {
          "confirm": {
            "default": false,
            "description": "Really delete this ticket. Pass true only after the user agreed",
            "type": "boolean",
          },
          "id": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "name": "deleteConversation",
    },
    "deleteConversationPermanently": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "Delete a ticket for good. This cannot be undone. Without confirm it only shows which ticket would go: show that to the user first.",
      "inputSchema": {
        "properties": {
          "confirm": {
            "default": false,
            "description": "Really delete this ticket for good. Pass true only after the user agreed",
            "type": "boolean",
          },
          "id": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "name": "deleteConversationPermanently",
    },
    "deleteDraft": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "Delete one of your own drafts from a ticket",
      "inputSchema": {
        "properties": {
          "conversationId": {
            "description": "Ticket number (e.g. 12345) or conversation ID the draft belongs to",
            "type": "string",
          },
          "draftId": {
            "description": "The draftId returned by listDrafts or createReplyDraft",
            "type": "string",
          },
        },
        "required": [
          "draftId",
          "conversationId",
        ],
        "type": "object",
      },
      "name": "deleteDraft",
    },
    "deleteNote": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "Delete an internal note. Without confirm it only shows the note that would go: show that to the user first.",
      "inputSchema": {
        "properties": {
          "confirm": {
            "default": false,
            "description": "Really delete this note. Pass true only after the user agreed",
            "type": "boolean",
          },
          "messageId": {
            "description": "ID of the note",
            "type": "string",
          },
        },
        "required": [
          "messageId",
        ],
        "type": "object",
      },
      "name": "deleteNote",
    },
    "editNote": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "Change the text of an internal note. Use listMessages to find its ID.",
      "inputSchema": {
        "properties": {
          "body": {
            "description": "New text of the note",
            "type": "string",
          },
          "messageId": {
            "description": "ID of the note",
            "type": "string",
          },
        },
        "required": [
          "messageId",
          "body",
        ],
        "type": "object",
      },
      "name": "editNote",
    },
    "forwardConversation": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "SENDS AN EMAIL IMMEDIATELY: forwards a ticket to the given addresses. The ticket keeps its state, and only gets a new subject if you pass one. Use only when the user explicitly asks.",
      "inputSchema": {
        "properties": {
          "bcc": {
            "description": "Email addresses to send a hidden copy to",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "body": {
            "description": "Message to add to the forward",
            "type": "string",
          },
          "cc": {
            "description": "Email addresses to send a copy to",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "confirm": {
            "default": false,
            "description": "Really send this mail to more than 5 people. Pass true only after the user agreed",
            "type": "boolean",
          },
          "conversationId": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
          "subject": {
            "description": "New subject. This also renames the ticket",
            "type": "string",
          },
          "to": {
            "description": "Email addresses to forward to",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
        },
        "required": [
          "conversationId",
          "to",
          "body",
        ],
        "type": "object",
      },
      "name": "forwardConversation",
    },
    "forwardConversation (2)": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "SENDS AN EMAIL IMMEDIATELY: forwards a ticket to the given addresses. The ticket keeps its state, and only gets a new subject if you pass one. Use only when the user explicitly asks.",
      "inputSchema": {
        "properties": {
          "attachments": {
            "description": "Files to attach, at most 25, up to 20 MB each. Each has a fileName and either a url (https) or contentBase64. Use url for anything but small files",
            "items": {
              "properties": {
                "contentBase64": {
                  "description": "File content as base64",
                  "type": "string",
                },
                "contentType": {
                  "description": "MIME type, for example application/pdf",
                  "type": "string",
                },
                "fileName": {
                  "description": "File name, with its extension",
                  "type": "string",
                },
                "url": {
                  "description": "Public https link to the file",
                  "type": "string",
                },
              },
              "required": [
                "fileName",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "bcc": {
            "description": "Email addresses to send a hidden copy to",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "body": {
            "description": "Message to add to the forward",
            "type": "string",
          },
          "cc": {
            "description": "Email addresses to send a copy to",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "confirm": {
            "default": false,
            "description": "Really send this mail to more than 5 people. Pass true only after the user agreed",
            "type": "boolean",
          },
          "conversationId": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
          "subject": {
            "description": "New subject. This also renames the ticket",
            "type": "string",
          },
          "to": {
            "description": "Email addresses to forward to",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
        },
        "required": [
          "conversationId",
          "to",
          "body",
        ],
        "type": "object",
      },
      "name": "forwardConversation",
    },
    "getAgent": {
      "annotations": {
