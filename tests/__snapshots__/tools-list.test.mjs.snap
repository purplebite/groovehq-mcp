  "definitions": {
    "closeConversation": {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false,
      },
      "description": "Close a conversation",
      "inputSchema": {
        "properties": {
          "id": {
            "description": "Ticket number (e.g. 12345) or conversation ID",
            "type": "string",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "name": "closeConversation",
    },
    "createContact": {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false,
      },
      "description": "Create a new contact",
      "inputSchema": {
        "properties": {
          "email": {
            "description": "Contact email address",
            "type": "string",
          },
          "firstName": {
            "description": "Contact first name",
            "type": "string",
          },
          "lastName": {
            "description": "Contact last name",
            "type": "string",
          },
          "phone": {
            "description": "Contact phone number",
            "type": "string",
          },
          "title": {
            "description": "Contact job title",
            "type": "string",
          },
        },
        "required": [
          "email",
        ],
        "type": "object",
      },
      "name": "createContact",
    },
    "createConversation": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "SENDS AN EMAIL IMMEDIATELY to the given address and creates a ticket. Use only when the user explicitly asks to send this message.",
      "inputSchema": {
        "properties": {
          "assignedAgentId": {
            "description": "ID of agent to assign the conversation to",
            "type": "string",
          },
          "assignedTeamId": {
            "description": "ID of team to assign the conversation to",
            "type": "string",
          },
          "bcc": {
            "description": "Email addresses to send a hidden copy to",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "body": {
            "description": "Initial message body",
            "type": "string",
          },
          "cc": {
            "description": "Email addresses to send a copy to",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "channelId": {
            "description": "ID of the channel to send from",
            "type": "string",
          },
          "snoozedUntil": {
            "description": "ISO 8601 datetime to snooze until. Needs state snoozed. Leave out to snooze indefinitely",
            "type": "string",
          },
          "state": {
            "default": "opened",
            "description": "State of the new ticket",
            "enum": [
              "opened",
              "closed",
              "snoozed",
            ],
            "type": "string",
          },
          "subject": {
            "description": "Subject of the conversation",
            "type": "string",
          },
          "tagIds": {
            "description": "Tag IDs to apply to the conversation",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "to": {
            "description": "Email address of the recipient",
            "type": "string",
          },
          "toName": {
            "description": "Name of the recipient (defaults to the email address)",
            "type": "string",
          },
        },
        "required": [
          "channelId",
          "to",
          "subject",
          "body",
        ],
        "type": "object",
      },
      "name": "createConversation",
    },
    "createConversation (2)": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "SENDS AN EMAIL IMMEDIATELY to the given address and creates a ticket. Use only when the user explicitly asks to send this message.",
      "inputSchema": {
        "properties": {
          "assignedAgentId": {
            "description": "ID of agent to assign the conversation to",
            "type": "string",
          },
          "assignedTeamId": {
            "description": "ID of team to assign the conversation to",
            "type": "string",
          },
          "authorId": {
            "description": "ID of the agent to act as. Defaults to the agent who owns the API token",
            "type": "string",
          },
          "bcc": {
            "description": "Email addresses to send a hidden copy to",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "body": {
            "description": "Initial message body",
            "type": "string",
          },
          "cc": {
            "description": "Email addresses to send a copy to",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "channelId": {
            "description": "ID of the channel to send from",
            "type": "string",
          },
          "snoozedUntil": {
            "description": "ISO 8601 datetime to snooze until. Needs state snoozed. Leave out to snooze indefinitely",
            "type": "string",
          },
          "state": {
            "default": "opened",
            "description": "State of the new ticket",
            "enum": [
              "opened",
              "closed",
              "snoozed",
            ],
            "type": "string",
          },
          "subject": {
            "description": "Subject of the conversation",
            "type": "string",
          },
          "tagIds": {
            "description": "Tag IDs to apply to the conversation",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "to": {
            "description": "Email address of the recipient",
            "type": "string",
          },
          "toName": {
            "description": "Name of the recipient (defaults to the email address)",
            "type": "string",
          },
        },
        "required": [
          "channelId",
          "to",
          "subject",
          "body",
        ],
        "type": "object",
      },
      "name": "createConversation",
    },
    "createConversation (3)": {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false,
      },
      "description": "SENDS AN EMAIL IMMEDIATELY to the given address and creates a ticket. Use only when the user explicitly asks to send this message.",
      "inputSchema": {
        "properties": {
          "assignedAgentId": {
