# For reference: the server reads these from its environment,
# so set them in your MCP client. It doesn't load this file.

# Required
GROOVE_API_TOKEN=your_groove_api_token_here

# Optional
# GROOVE_API_URL=https://api.groovehq.com/v2/graphql
# GROOVE_READ_ONLY=1              # leave out every tool that writes
# GROOVE_ALLOW_SEND=1             # allow tools that send email
# GROOVE_ALLOW_SEND_AS=1          # allow acting as another agent
# GROOVE_ALLOW_PERMANENT_DELETE=1 # allow deleting tickets for good
# GROOVE_ALLOW_MERGE=0            # turn off merging tickets and contacts
# GROOVE_ALLOW_ATTACHMENTS=1      # allow attaching files, from a link or as base64

# Only for scripts/live-test.mjs
# GROOVE_TEST_TO=you@example.com
# GROOVE_TEST_CHANNEL=ch_123
# GROOVE_TEST_TICKET=12345
